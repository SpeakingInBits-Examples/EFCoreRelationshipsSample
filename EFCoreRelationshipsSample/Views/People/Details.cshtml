@model EFCoreRelationshipsSample.Models.Person

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Person</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FullName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FullName)
        </dd>
        <dt class = "col-sm-2">
            Passport
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Passport != null)
            {
                <a asp-controller="Passports" asp-action="Details" asp-route-id="@Model.Passport.Id">@Model.Passport.PassportNumber</a>
            }
            else
            {
                <span>No passport on file.</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
