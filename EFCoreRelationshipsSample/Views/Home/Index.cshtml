@{
    ViewData["Title"] = "Home Page";
}

<h2>EF Core Relationship Examples</h2>

<h3>Single Entity : No Relationships</h3>
<ul>
    <li>
        <a asp-controller="FoodItems" asp-action="Index">Food Item</a>
    </li>
    <li>
        <a asp-controller="Courses" asp-action="Index">Course</a>
    </li>
    <li>
		<a asp-controller="Students" asp-action="Index">Student</a>
    </li>
</ul>

<h3>One-to-one Relationship</h3>
<ul>
    <li>
        <a asp-controller="People" asp-action="Index">People</a> &ndash; each person has at most one passport
    </li>
    <li>
        <a asp-controller="Passports" asp-action="Index">Passports</a> &ndash; each passport belongs to one person
    </li>
</ul>

<h3>One-to-many Relationship</h3>
<ul>
    <li>
        <a asp-controller="Blogs" asp-action="Index">Blogs</a> &ndash; a blog has many posts
    </li>
    <li>
        <a asp-controller="Posts" asp-action="Index">Posts</a> &ndash; each post belongs to one blog
    </li>
</ul>

<h3>Many-to-many Relationship</h3>
<ul>
    <li>
        <a asp-controller="Students" asp-action="Index">Edit a student to see their course enrollment</a>
	</li>
    <li>
		<a asp-controller="Courses" asp-action="Index">View course details to see student roster</a>
    </li>
    <li>
        <a asp-controller="CourseDashboard" asp-action="CourseRosters">See all course rosters</a>
    </li>
</ul>